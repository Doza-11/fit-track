# Copy to android/keystore.properties and fill in your own values.
# That file is git-ignored — never commit real credentials.
#
# storeFile is resolved relative to the android/ directory, so an absolute
# path outside the repository is the safest choice.
storeFile=/Users/you/keystores/fittrack-release.jks
storePassword=CHANGE_ME
keyAlias=fittrack
keyPassword=CHANGE_ME
