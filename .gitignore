# Capacitor
# The native android/ and ios/ projects ARE tracked — they hold the manifest,
# build config and signing wiring. Each has its own .gitignore that excludes
# build output, Pods and DerivedData.

# Signing secrets — never commit these (see docs/ANDROID.md)
*.keystore
*.jks
android/keystore.properties
android/app/release/

# TypeScript build info
*.tsbuildinfo

# Android SDK path (machine-specific)
android/local.properties
